{
  "env": {
    "browser": true,
    "es6": true,
    "jest": true
  },
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "extends": ["airbnb-base"],
  "rules": {
    "no-shadow": "off",
    "no-param-reassign": "off",
    "eol-last": "off",
    "linebreak-style": "off",
    "import/extensions": "off",
    "arrow-parens": "off",
    "no-confusing-arrow": "off",
    "implicit-arrow-linebreak": "off",
    "comma-dangle": "off",
    "function-paren-newline": "off",
    "quotes": "off"
  },
  "ignorePatterns": [
    "dist/",
    "build/",
    "To-do-App/src/",
    "To-do-App/"
  ]
}